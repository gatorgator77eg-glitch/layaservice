# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets and local configuration. The service reads everything from environment
# variables, so a committed .env is a committed credential.
.env
.env.*
!.env.example

# Checkpoint weights and the Hugging Face cache. These live outside the project by
# default (~/.cache/huggingface), but a local HF_HOME or a vendored download would
# otherwise be several GB in a commit. Warm the cache with:
#   python -m scripts.warmup --models all --verify-offline
*.safetensors
*.bin
*.pt
*.onnx
models--*/

# Logs and editor noise
*.log
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# OS
nohup.out
